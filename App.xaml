<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NoteManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NoteManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:SaveStatusToTextConverter x:Key="SaveStatusToTextConverter" />
            <converters:DateTimeToLocalStringConverter x:Key="DateTimeToLocalStringConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <CornerRadius x:Key="PanelCorner">14</CornerRadius>
            <Thickness x:Key="PanelPadding">16</Thickness>
            <x:Double x:Key="NavIconSize">16</x:Double>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PanelCorner}" />
                <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,12,0,6" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>