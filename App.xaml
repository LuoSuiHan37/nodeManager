<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NoteManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NoteManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:SaveStatusToTextConverter x:Key="SaveStatusToTextConverter" />
            <converters:DateTimeToLocalStringConverter x:Key="DateTimeToLocalStringConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <!-- Fluent 2 design tokens: keep surfaces semantic so Light/Dark stay in sync. -->
            <!-- Joplin-inspired desktop workbench tokens: compact, content-first, low ornament. -->
            <CornerRadius x:Key="PanelCorner">6</CornerRadius>
            <CornerRadius x:Key="ControlCorner">4</CornerRadius>
            <Thickness x:Key="PanelPadding">12</Thickness>
            <x:Double x:Key="NavIconSize">16</x:Double>
            <x:Double x:Key="ControlHeight">36</x:Double>
            <x:Double x:Key="CompactControlHeight">32</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SecondaryFontSize">12</x:Double>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PanelCorner}" />
                <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            </Style>

            <Style x:Key="NavigationSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="WorkspaceSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="EditorSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
            </Style>

            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,16,0,6" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
