<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NoteManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NoteManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EAF3FF" />
                    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#DCEBFF" />
                    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#E5F0FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B2028" />
                    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#203A5F" />
                    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#253B59" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:SaveStatusToTextConverter x:Key="SaveStatusToTextConverter" />
            <converters:DateTimeToLocalStringConverter x:Key="DateTimeToLocalStringConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <!-- Fluent 2 design tokens: keep surfaces semantic so Light/Dark stay in sync. -->
            <!-- Joplin-inspired desktop workbench tokens: compact, content-first, low ornament. -->
            <CornerRadius x:Key="PanelCorner">12</CornerRadius>
            <CornerRadius x:Key="ControlCorner">8</CornerRadius>
            <Thickness x:Key="PanelPadding">16</Thickness>
            <x:Double x:Key="NavIconSize">16</x:Double>
            <x:Double x:Key="ControlHeight">36</x:Double>
            <x:Double x:Key="CompactControlHeight">32</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SecondaryFontSize">12</x:Double>
            <x:Double x:Key="PaneSpacing">8</x:Double>
            <x:Double x:Key="SidebarWidth">248</x:Double>
            <x:Double x:Key="ListPaneWidth">336</x:Double>

            <SolidColorBrush x:Key="NavButtonBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="EditorRedBrush" Color="#D13438" />
            <SolidColorBrush x:Key="EditorGreenBrush" Color="#107C10" />
            <SolidColorBrush x:Key="EditorBlueBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="EditorOrangeBrush" Color="#C43E1C" />
            <SolidColorBrush x:Key="EditorPurpleBrush" Color="#8764B8" />

            <!-- Semantic surface tokens: every pane uses the same light/dark-aware palette. -->
            <Style x:Key="PaneBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PanelCorner}" />
            </Style>

            <Style x:Key="PanelBorderStyle" TargetType="Border" BasedOn="{StaticResource PaneBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            </Style>

            <Style x:Key="NavigationSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="WorkspaceSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="20,18" />
            </Style>

            <Style x:Key="EditorSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="24,22" />
            </Style>

            <Style x:Key="EditorToolbarStyle" TargetType="Border" BasedOn="{StaticResource PaneBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCorner}" />
            </Style>

            <Style x:Key="EditorTitleSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneBorderStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style x:Key="EditorContentSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="ListItemSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="NoteListItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="112" />
                <Setter Property="MinHeight" Value="112" />
                <Setter Property="MaxHeight" Value="112" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="NoteItemActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="AppCardStyle" TargetType="Border" BasedOn="{StaticResource PaneBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
            </Style>

            <Style x:Key="SidebarNavItemStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
            </Style>

            <Style x:Key="EditorToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="EditorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}" />

            <Style x:Key="TagColorDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SearchInputTextBoxStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="34,10,78,10" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="TitleInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="5,0,0,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="ContentElement"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsTabStop="False"
                                              ZoomMode="Disabled" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
            </Style>

            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,16,0,6" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
